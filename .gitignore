# Committing dist to allow installation from github commits and avoid tsconfig paths
# resolution issues when using this package as a library
# dist/
# The pre-commit hook runs `git add dist`, so a tarball left there by a manual
# `npm pack --pack-destination dist` would land in the repo. Never want one committed.
dist/*.tgz
build/
node_modules/
.eslintcache
.husky/_/
.nyc_output/
tests/cypress/videos/*
!tests/cypress/videos/.gitignore
tests/cypress/screenshots/*
!tests/cypress/screenshots/.gitignore
tests/cypress/downloads/*
!tests/cypress/downloads/.gitignore
.idea/
.DS_Store
src/react-app-env.d.ts

# Provisioned Pyodide REPL wheels + AX manifests, downloaded by scripts/provision-repl-wheels.mjs.
# The directory name is owned by REPL_WHEELS_DIRECTORY_NAME in src/components/repl/constants.ts;
# it has to be repeated literally here because .gitignore cannot read TypeScript.
public/repl-wheels/*
public/repl-config.yml
public/repl-pyodide-lock.json
