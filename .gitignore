# Committing dist to allow installation from github commits and avoid tsconfig paths
# resolution issues when using this package as a library
# dist/
build/
node_modules/
.eslintcache
.husky/_/
.nyc_output/
tests/cypress/videos/*
!tests/cypress/videos/.gitignore
tests/cypress/screenshots/*
!tests/cypress/screenshots/.gitignore
tests/cypress/downloads/*
!tests/cypress/downloads/.gitignore
.idea/
.DS_Store
src/react-app-env.d.ts

# Provisioned Pyodide REPL wheels, downloaded by scripts/provision-repl-wheels.mjs.
# The directory name is owned by `wheelsDirectoryName` in src/components/repl/repl-packages.json;
# it has to be repeated literally here because .gitignore cannot read JSON.
public/repl-wheels/

# Generated from src/components/repl/python/*.py by scripts/generate-repl-python.mjs
src/components/repl/python/generated/
