        "@mat3ra/code": "https://github.com/mat3ra/code/releases/download/wip-21b20a7/code.tgz",
        "@mat3ra/cove": "2026.11.17-1",
        "@mat3ra/eslint-config": "^2026.7.12-0",
        "@mat3ra/esse": "https://github.com/mat3ra/esse/releases/download/wip-d45a08e/esse.tgz",
        "@mat3ra/made": "https://github.com/mat3ra/made/releases/download/wip-c42985e/made.tgz",
        "@mat3ra/standata": "2026.11.20-0",
        "@mat3ra/tsconfig": "^2024.6.3-0",
