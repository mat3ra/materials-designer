{
    "name": "@mat3ra/materials-designer",
    "version": "0.0.0",
    "description": "Materials Designer",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "prepare": "husky install",
        "transpile": "tsc && npm run copy-css",
        "copy-css": "mkdir -p dist/stylesheets && cp src/stylesheets/* dist/stylesheets/",
        "test": "echo 'Tests are in the tests subfolder. Use Node 20 (`nvm use 20`) and run `npm i` && `npm test` there'",
        "lint": "eslint src && prettier --write src",
        "lint:fix": "eslint src --fix && prettier --write src",
        "prestart": "npm-link-shared ./node_modules/@mat3ra/cove/node_modules . react; npm-link-shared ./node_modules/@mat3ra/wave.js/node_modules . react",
        "prettier": "prettier --check src tests",
        "prepublishOnly": "npm run transpile"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/materials-designer.git"
    },
    "main": "dist/exports.js",
    "files": [
        "dist"
    ],
    "author": "Exabyte Inc.",
    "bugs": {
        "url": "https://github.com/mat3ra/materials-designer/issues"
    },
    "license": "Apache-2.0",
    "homepage": ".",
    "dependencies": {
        "@babel/cli": "7.29.7",
        "@babel/core": "7.29.13",
        "@babel/runtime": "7.29.15",
        "@babel/runtime-corejs2": "7.29.15",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mat3ra/utils": "2026.11.6-0",
        "@mui/icons-material": "^5.18.0",
        "@mui/lab": "^5.0.0-alpha.177",
        "@mui/material": "^5.18.0",
        "@mui/styles": "^5.18.0",
        "@mui/x-data-grid": "^6.20.4",
        "@types/lodash": "^4.17.27",
        "@types/react-s-alert": "^1.4.0",
        "classnames": "2.5.1",
        "lodash": "^4.18.1",
        "mathjs": "^3.20.2",
        "mixwith": "^0.1.1",
        "notistack": "^3.0.2",
        "path-browserify": "^1.0.1",
        "prop-types": "^15.8.1",
        "sprintf-js": "^1.1.3",
        "underscore": "^1.13.8",
        "underscore.string": "^3.3.6"
    },
    "peerDependencies": {
        "@mat3ra/code": "*",
        "@mat3ra/cove": "*",
        "@mat3ra/esse": "*",
