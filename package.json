    "resolutions": {
        "react-error-overlay": "6.0.9"
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not ie <= 11",
        "not op_mini all"
    ],
    "engines": {
        "node": ">=20.0",
        "npm": ">=6.14"
    }
